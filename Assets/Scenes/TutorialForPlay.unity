  roomDialogue:
    lines: []
    loopSequence: 0
  useCustomLines: 1
  customDialogueLines:
  - text: See that computer terminal on your right? Use that to upgrade your programming
      and strengthen the effects of your emotions.
    displayDuration: 4
    speakerName: 
    voiceClip: {fileID: 0}
    autoAdvance: 0
    waitForInput: 1
    useItalics: 0
  - text: You'll come across upgrade chips throughout the floors of HAVOC's building.
    displayDuration: 4
    speakerName: 
    voiceClip: {fileID: 0}
    autoAdvance: 0
    waitForInput: 1
    useItalics: 0
  - text: 'Press {SKILLTREE} to bring up your skill tree.

      You can access it
      at any point out of combat but upgrades can only be purchased at a computer
      terminal.'
    displayDuration: 4
    speakerName: 
    voiceClip: {fileID: 0}
    autoAdvance: 0
    waitForInput: 1
    useItalics: 1
  - text: Press {INTERACT} to interact with the computer terminal.
    displayDuration: 4
    speakerName: 
    voiceClip: {fileID: 0}
    autoAdvance: 0
    waitForInput: 1
    useItalics: 1
  triggerOnce: 1
  requiresTag: 1
