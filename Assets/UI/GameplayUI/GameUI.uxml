    <ui:VisualElement name="HealthBarBackground" style="flex-grow: 1; position: absolute; width: 500px; height: 150px; background-image: url(&quot;project://database/Assets/UI/GameplayUI/Temp%20Assets/HealthbarBackground.png?fileID=2800000&amp;guid=309059e53eed8bf409b438171cf0c9c6&amp;type=3#HealthbarBackground&quot;);">
